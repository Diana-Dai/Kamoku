{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign container = section.settings.container
-%}
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<section
  id="{{ section_id }}"
  data-section-type="comparison-timeline"
  data-section-id="{{ section.id }}"
  class="comparison-timeline f-section-padding color-{{ section.settings.color_schema }}{{ custom_class }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <style>
    #{{ section_id }} {
      --comparison-gap: {{ section.settings.panel_gap }}px;
      --comparison-radius: {{ section.settings.panel_radius }}px;
      --comparison-border-color: {{ section.settings.panel_border_color }};
      --comparison-border-width: {{ section.settings.panel_border_width }}px;
      --comparison-left-bg: {{ section.settings.left_panel_bg }};
      --comparison-right-bg: {{ section.settings.right_panel_bg }};
      --comparison-panel-padding: {{ section.settings.panel_padding }}px;
      --comparison-row-padding-y: {{ section.settings.row_padding_y }}px;
      --comparison-row-padding-x: {{ section.settings.row_padding_x }}px;
      --comparison-divider-color: {{ section.settings.row_divider_color }};
      --comparison-label-color: {{ section.settings.label_color }};
      --comparison-day-color: {{ section.settings.day_color }};
      --comparison-text-color: {{ section.settings.text_color }};
      --comparison-note-color: {{ section.settings.note_color }};
      --comparison-accent-color: {{ section.settings.accent_color }};
    }

    #{{ section_id }} .comparison-timeline__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--comparison-gap);
      align-items: stretch;
    }

    #{{ section_id }} .comparison-timeline__panel {
      min-width: 0;
      border: var(--comparison-border-width) solid var(--comparison-border-color);
      border-radius: var(--comparison-radius);
      padding: var(--comparison-panel-padding);
      display: flex;
      flex-direction: column;
      gap: 24px;
      min-height: 100%;
    }

    #{{ section_id }} .comparison-timeline__panel--left {
      background: var(--comparison-left-bg);
    }

    #{{ section_id }} .comparison-timeline__panel--right {
        color:white;
      background: var(--comparison-right-bg);
      box-shadow: 3px 3px 3px 0px rgba(0, 0, 0, 0.1);
    }
#{{ section_id }} .comparison-timeline__panel--right *{
        color:white !important;
}
    #{{ section_id }} .comparison-timeline__intro {
      max-width: 64rem;
      margin-bottom: 28px;
    }

    #{{ section_id }}  .comparison-timeline__eyebrow {
      margin: 0 0 12px;
      text-transform: uppercase;
      letter-spacing: 0.28em;
      font-size: 0.72rem;
      line-height: 1.2;
    }

    #{{ section_id }} .comparison-timeline__heading {
      margin: 0;
    }

    #{{ section_id }} .comparison-timeline__description {
      margin-top: 12px;
      max-width: 52rem;
    }

    #{{ section_id }} .comparison-timeline__panel-eyebrow {
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 3%;

    }
    #{{ section_id }} .comparison-timeline__panel--left .comparison-timeline__panel-eyebrow {
      color: var(--comparison-label-color);

    }
    #{{ section_id }} .comparison-timeline__panel-note {
      margin: 0;
      color: var(--comparison-note-color);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    #{{ section_id }} .comparison-timeline__rows {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--comparison-divider-color);
    }

    #{{ section_id }} .comparison-timeline__row {
      display: grid;
      grid-template-columns: minmax(3.5rem, 0.28fr) minmax(0, 1fr) 1px;
      gap: 24px;
      padding: var(--comparison-row-padding-y) var(--comparison-row-padding-x);
      border-bottom: 1px solid var(--comparison-divider-color);
      align-items: start;
    }

    #{{ section_id }} .comparison-timeline__day {
      margin: 0;
      color: var(--comparison-day-color);
    }

    #{{ section_id }} .comparison-timeline__content {
      min-width: 0;
    }

    #{{ section_id }} .comparison-timeline__title {
      margin: 0;
      color: var(--comparison-row-accent, var(--comparison-accent-color));
    }

    #{{ section_id }} .comparison-timeline__text {
      margin-top: 8px;
      color: var(--comparison-text-color);
    }


    #{{ section_id }} .comparison-timeline__footer {
      margin-top: auto;
      padding-top: 4px;
    }


    @media screen and (max-width: 989px) {
      #{{ section_id }} .comparison-timeline__grid {
        grid-template-columns: 1fr;
      }

      #{{ section_id }} .comparison-timeline__panel {
        gap: 20px;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} .comparison-timeline__intro {
        margin-bottom: 20px;
      }

      #{{ section_id }} .comparison-timeline__panel {
        padding: 22px;
      }

      #{{ section_id }} .comparison-timeline__row {
        grid-template-columns: minmax(3rem, 0.3fr) minmax(0, 1fr) 1px;
        gap: 16px;
        padding-left: 0;
        padding-right: 0;
      }
    }
  </style>

  <div class="{{ container }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="comparison-timeline__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="comparison-timeline__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="comparison-timeline__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="comparison-timeline__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="comparison-timeline__grid">
      <article class="comparison-timeline__panel comparison-timeline__panel--left">
        <div>
          {%- if section.settings.left_eyebrow != blank -%}
            <p class="comparison-timeline__panel-eyebrow h4">{{ section.settings.left_eyebrow | escape }}</p>
          {%- endif -%}
        </div>

        <div class="comparison-timeline__rows">
          {%- for block in section.blocks -%}
            {%- liquid
              assign left_day = block.settings.left_day
              assign left_title = block.settings.left_title
              assign left_description = block.settings.left_description
              assign left_accent_color = block.settings.left_accent_color

              if left_day == blank and left_title == blank and left_description == blank
                continue
              endif
            -%}

            <div class="comparison-timeline__row" {{ block.shopify_attributes }}>
              <p class="comparison-timeline__day">{{ left_day }}</p>
              <div class="comparison-timeline__content">
                {%- if left_title != blank -%}
                  <h5
                    class="comparison-timeline__title"
                    {% if left_accent_color != blank %}
                      style="--comparison-row-accent: {{ left_accent_color }};"
                    {% endif %}
                  >
                    {{ left_title }}
                  </h5>
                {%- endif -%}
                {%- if left_description != blank -%}
                  <div class="comparison-timeline__text rte">
                    {{ left_description }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.left_footer != blank -%}
          <div class="comparison-timeline__footer comparison-timeline__footer--left">
            <p class="comparison-timeline__panel-note">{{ section.settings.left_footer }}</p>
          </div>
        {%- endif -%}
      </article>

      <article class="comparison-timeline__panel comparison-timeline__panel--right">
        <div>
          {%- if section.settings.right_eyebrow != blank -%}
            <p class="comparison-timeline__panel-eyebrow h4">{{ section.settings.right_eyebrow | escape }}</p>
          {%- endif -%}
        </div>

        <div class="comparison-timeline__rows">
          {%- for block in section.blocks -%}
            {%- liquid
              assign right_day = block.settings.right_day
              assign right_title = block.settings.right_title
              assign right_description = block.settings.right_description
              assign right_accent_color = block.settings.right_accent_color

              if right_day == blank and right_title == blank and right_description == blank
                continue
              endif
            -%}

            <div class="comparison-timeline__row" {{ block.shopify_attributes }}>
              <p class="comparison-timeline__day">{{ right_day }}</p>
              <div class="comparison-timeline__content">
                {%- if right_title != blank -%}
                  <h5
                    class="comparison-timeline__title"
                    {% if right_accent_color != blank %}
                      style="--comparison-row-accent: {{ right_accent_color }};"
                    {% endif %}
                  >
                    {{ right_title }}
                  </h5>
                {%- endif -%}
                {%- if right_description != blank -%}
                  <div class="comparison-timeline__text rte">
                    {{ right_description }}
                  </div>
                {%- endif -%}
              </div>
              <span
                class="comparison-timeline__marker"
                {% if right_accent_color != blank %}
                  style="--comparison-row-accent: {{ right_accent_color }};"
                {% endif %}
                aria-hidden="true"
              ></span>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.right_footer != blank -%}
          <div class="comparison-timeline__footer comparison-timeline__footer--right">
            <p class="comparison-timeline__panel-note">{{ section.settings.right_footer }}</p>
          </div>
        {%- endif -%}
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison timeline",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Fixed"
        },
        {
          "value": "container-fluid",
          "label": "Stretched"
        },
        {
          "value": "container-full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_schema",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Heading" 
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        { "value": "h4", "label": "Small" },
        { "value": "h3", "label": "Medium" },
        { "value": "h2", "label": "Large" },
        { "value": "h1", "label": "Extra large" }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Panels"
    },
    {
      "type": "text",
      "id": "left_eyebrow",
      "label": "Left panel eyebrow",
      "default": "Traditional approach"
    },
    {
      "type": "richtext",
      "id": "left_footer",
      "label": "Left panel footer",
      "default": "<p>One formula. No adaptation. No understanding of the healing process.</p>"
    },
    {
      "type": "color",
      "id": "left_panel_bg",
      "label": "Left panel background",
      "default": "#f2eeea"
    },
    {
      "type": "text",
      "id": "right_eyebrow",
      "label": "Right panel eyebrow",
      "default": "Kamoku"
    },
    {
      "type": "richtext",
      "id": "right_footer",
      "label": "Right panel footer",
      "default": "<p>Three formulations. Each calibrated to a distinct biological phase.</p>"
    },
    {
      "type": "color",
      "id": "right_panel_bg",
      "label": "Right panel background",
      "default": "#f7f4ef"
    },
    {
      "type": "header",
      "content": "Styles"
    },
    {
      "type": "color",
      "id": "panel_border_color",
      "label": "Panel border color",
      "default": "rgba(0,0,0,0.08)"
    },
    {
      "type": "range",
      "id": "panel_border_width",
      "label": "Panel border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "panel_gap",
      "label": "Panel gap",
      "min": 12,
      "max": 56,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "panel_padding",
      "label": "Panel padding",
      "min": 16,
      "max": 64,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_padding_y",
      "label": "Row padding vertical",
      "min": 10,
      "max": 36,
      "step": 1,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_padding_x",
      "label": "Row padding horizontal",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "row_divider_color",
      "label": "Row divider color",
      "default": "rgba(0,0,0,0.08)"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "rgba(0,0,0,0.38)"
    },
    {
      "type": "color",
      "id": "day_color",
      "label": "Day color",
      "default": "rgba(0,0,0,0.45)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0.72)"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Footer color",
      "default": "rgba(0,0,0,0.46)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Default accent color",
      "default": "#2f2a25"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Custom attributes"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "label": "Show section divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_width",
      "label": "Divider width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Fixed" },
        { "value": "container-fluid", "label": "Stretched" }
      ]
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "left_day",
          "label": "Left day",
          "default": "Day 1"
        },
        {
          "type": "text",
          "id": "left_title",
          "label": "Left title",
          "default": "Generic Balm"
        },
        {
          "type": "richtext",
          "id": "left_description",
          "label": "Left description",
          "default": "<p>Petroleum-based occlusives smother the wound bed, trapping heat and bacteria.</p>"
        },
        {
          "type": "color",
          "id": "left_accent_color",
          "label": "Left title accent",
          "default": "rgba(0,0,0,0.24)"
        },
        {
          "type": "header",
          "content": "Right side"
        },
        {
          "type": "text",
          "id": "right_day",
          "label": "Right day",
          "default": "Day 1–3"
        },
        {
          "type": "text",
          "id": "right_title",
          "label": "Right title",
          "default": "01 HYDRO GEL"
        },
        {
          "type": "richtext",
          "id": "right_description",
          "label": "Right description",
          "default": "<p>Cooling + sealing + sterile barrier</p>"
        },
        {
          "type": "color",
          "id": "right_accent_color",
          "label": "Right title accent",
          "default": "#d07d45"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison timeline",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}