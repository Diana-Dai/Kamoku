    "custom_liquid_fELaHT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "container": "container-full",
        "color_schema": "",
        "custom_liquid": "{% liquid\nassign cosmo_uid = section.id | default: 'homepage'\nassign cosmo_form = 'cosmo-form-' | append: cosmo_uid\n%}\n<section class=\"kamoku-cosmo\" aria-labelledby=\"cosmo-title-{{ cosmo_uid }}\">\n<div class=\"kamoku-cosmo__art\" aria-hidden=\"true\"></div>\n<svg class=\"kamoku-cosmo__stamp\" viewBox=\"0 0 270 210\" aria-hidden=\"true\" focusable=\"false\"><defs><path id=\"cosmo-stamp-{{ cosmo_uid }}\" d=\"M105,31 a74,74 0 1,1 0,148 a74,74 0 1,1 0,-148\"/></defs><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"><circle cx=\"105\" cy=\"105\" r=\"94\"/><circle cx=\"105\" cy=\"105\" r=\"90.5\"/><path d=\"M181 67 C205 51,218 87,241 72 S264 68,278 72 M188 84 C210 69,222 102,244 88 S265 84,278 88 M194 101 C216 87,226 119,248 105 S267 101,278 105 M194 118 C216 104,226 136,248 122 S267 118,278 122\"/></g><text fill=\"currentColor\" font-size=\"11.4\" letter-spacing=\"2.4\"><textPath href=\"#cosmo-stamp-{{ cosmo_uid }}\">CARE FOR THE SKIN · RESPECT THE ART ·</textPath></text><text x=\"105\" y=\"110\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"17\" letter-spacing=\"2\">KĀMOKU</text></svg>\n<div class=\"kamoku-cosmo__content\">\n<p class=\"kamoku-cosmo__eyebrow\">JOIN THE</p>\n<h2 class=\"kamoku-cosmo__title\" id=\"cosmo-title-{{ cosmo_uid }}\">Cosmo Club</h2>\n<svg class=\"kamoku-cosmo__underline\" viewBox=\"0 0 440 12\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M2 8 C112 1,263 3,437 6 C294 4,155 5,2 9 Z\" fill=\"currentColor\"/></svg>\n<p class=\"kamoku-cosmo__description\">Be the first to know about new collections,<br class=\"kamoku-cosmo__desktop-break\"> exclusive offers, and the latest from KĀMOKU.</p>\n{% form 'customer', id: cosmo_form, class: 'kamoku-cosmo__form' %}\n<input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter\">\n{% if form.posted_successfully? %}<div class=\"kamoku-cosmo__success\" role=\"status\"><p><strong>Welcome to the Cosmo Club.</strong></p><p>Thanks for joining. Keep an eye on your inbox.</p></div>\n{% else %}\n{% if form.errors %}<div class=\"kamoku-cosmo__errors\" id=\"cosmo-errors-{{ cosmo_uid }}\" role=\"alert\">{{ form.errors | default_errors }}</div>{% endif %}\n<label class=\"kamoku-cosmo__sr-only\" for=\"cosmo-email-{{ cosmo_uid }}\">Email address</label>\n<div class=\"kamoku-cosmo__email-wrap\"><input class=\"kamoku-cosmo__email\" id=\"cosmo-email-{{ cosmo_uid }}\" type=\"email\" name=\"contact[email]\" value=\"{{ form.email | escape }}\" placeholder=\"Enter your email address\" autocomplete=\"email\" autocapitalize=\"off\" autocorrect=\"off\" required {% if form.errors %}aria-invalid=\"true\" aria-describedby=\"cosmo-errors-{{ cosmo_uid }}\"{% endif %}><button class=\"kamoku-cosmo__submit\" type=\"submit\" aria-label=\"Join the Cosmo Club\"><svg width=\"25\" height=\"22\" viewBox=\"0 0 25 22\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 11 H21 M15.5 5.5 L21 11 L15.5 16.5\" stroke=\"currentColor\" stroke-width=\"1.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div>\n<div class=\"kamoku-cosmo__consent\"><input class=\"kamoku-cosmo__checkbox\" id=\"cosmo-consent-{{ cosmo_uid }}\" type=\"checkbox\" name=\"contact[accepts_marketing]\" value=\"true\" required><label for=\"cosmo-consent-{{ cosmo_uid }}\">By subscribing you agree to the <a href=\"/policies/terms-of-service\">Terms of Use</a> &amp; <a href=\"/policies/privacy-policy\">Privacy Policy</a>.</label></div>\n{% endif %}{% endform %}\n</div></section>\n<style>\n.kamoku-cosmo{--cosmo-ink:#2c3023;--cosmo-olive:#4c5333;--cosmo-muted:#6e7063;position:relative;isolation:isolate;width:100%;height:clamp(480px,37.7vw,680px);overflow:hidden;color:var(--cosmo-ink);background:#f0ece2;font-family:Arial,Helvetica,sans-serif;text-align:left}\n.kamoku-cosmo *,.kamoku-cosmo *::before,.kamoku-cosmo *::after{box-sizing:border-box}\n.kamoku-cosmo__art{position:absolute;inset:0;z-index:-1;background:url('https://cdn.shopify.com/s/files/1/0769/3991/9405/files/kamoku-cosmo-club-background.png?v=1792134782') center/cover no-repeat}\n.kamoku-cosmo__content{position:relative;width:30.5%;margin-left:47.3%;padding-top:clamp(62px,5.3vw,96px)}\n.kamoku-cosmo__eyebrow{margin:0 0 7px;font-size:clamp(13px,1.16vw,19px);font-weight:400;line-height:1.5;letter-spacing:.34em}\n.kamoku-cosmo__title{margin:0;padding:0;color:var(--cosmo-ink);font-family:Georgia,'Times New Roman',serif;font-size:clamp(58px,5.4vw,96px);font-weight:400;line-height:1.08;letter-spacing:-.05em;white-space:nowrap;text-transform:none}\n.kamoku-cosmo__underline{display:block;width:69%;height:10px;margin-top:0;color:var(--cosmo-olive)}\n.kamoku-cosmo__description{margin:19px 0 29px;color:var(--cosmo-muted);font-size:clamp(15px,1.29vw,21px);font-weight:400;line-height:1.45;letter-spacing:-.015em}\n.kamoku-cosmo__form{display:block;margin:0}\n.kamoku-cosmo__email-wrap{position:relative;display:flex;align-items:center;width:100%;min-height:58px;border:1px solid #dedbd0;border-radius:999px;background:rgba(255,254,249,.75)}\n.kamoku-cosmo__email{display:block;width:100%;height:56px;margin:0;padding:0 72px 0 19px;border:0;border-radius:999px;outline:none;color:var(--cosmo-ink);background:transparent;box-shadow:none;font:400 14px/1.3 Arial,Helvetica,sans-serif}\n.kamoku-cosmo__email::placeholder{color:#78796e;opacity:1}\n.kamoku-cosmo__email-wrap:focus-within{outline:2px solid var(--cosmo-olive);outline-offset:3px}\n.kamoku-cosmo__submit{position:absolute;right:-1px;top:-1px;display:grid;place-items:center;width:58px;height:58px;min-width:58px;margin:0;padding:0;border:0;border-radius:50%;color:#f3f0e3;background:var(--cosmo-olive);box-shadow:none;cursor:pointer;transition:background-color .18s ease}\n.kamoku-cosmo__submit:hover{background:#363e26}\n.kamoku-cosmo__submit:focus-visible,.kamoku-cosmo__checkbox:focus-visible,.kamoku-cosmo__consent a:focus-visible{outline:2px solid var(--cosmo-ink);outline-offset:4px}\n.kamoku-cosmo__submit svg{display:block}\n.kamoku-cosmo__consent{display:flex;align-items:flex-start;gap:9px;margin-top:17px;color:var(--cosmo-muted);font-size:12px;line-height:1.55;letter-spacing:-.01em}\n.kamoku-cosmo__checkbox{flex:0 0 18px;width:18px;height:18px;margin:1px 0 0;padding:0;accent-color:var(--cosmo-olive);cursor:pointer}\n.kamoku-cosmo__consent label{display:block;margin:0;color:inherit;font-size:inherit;font-weight:400;line-height:inherit;cursor:pointer}\n.kamoku-cosmo__consent a{color:inherit;text-decoration:underline;text-underline-offset:2px}\n.kamoku-cosmo__stamp{position:absolute;top:3.5%;left:79%;width:17.3%;max-width:310px;height:auto;color:#73785f;opacity:.86;pointer-events:none;transform:rotate(-9deg)}\n.kamoku-cosmo__errors{margin:0 0 12px;padding:10px 14px;border:1px solid #a56652;border-radius:8px;color:#783d2c;background:#fff5ed;font-size:13px;line-height:1.5}\n.kamoku-cosmo__success{padding:18px 20px;border:1px solid #b6bba2;border-radius:12px;color:var(--cosmo-ink);background:rgba(250,250,240,.8);font-size:14px;line-height:1.5}\n.kamoku-cosmo__success p{margin:0}\n.kamoku-cosmo__sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(min-width:769px) and (max-width:1100px){.kamoku-cosmo__content{width:44%;margin-left:44%;padding-top:65px}.kamoku-cosmo__title{font-size:clamp(58px,6.6vw,73px)}.kamoku-cosmo__description{font-size:16px}.kamoku-cosmo__stamp,.kamoku-cosmo__desktop-break{display:none}}\n@media(max-width:768px){.kamoku-cosmo{height:auto;min-height:0;padding-top:280px;background:#f0ece2}.kamoku-cosmo__art{bottom:auto;height:280px;background-position:left top;background-size:auto 280px}.kamoku-cosmo__art::after{content:'';position:absolute;right:0;bottom:-1px;left:0;height:62px;background:linear-gradient(transparent,#f0ece2)}.kamoku-cosmo__content{width:100%;margin:0;padding:24px 24px 42px;background:#f0ece2}.kamoku-cosmo__eyebrow{margin-bottom:5px;font-size:12px;letter-spacing:.32em}.kamoku-cosmo__title{font-size:50px;line-height:1.1;letter-spacing:-.05em}.kamoku-cosmo__underline{width:195px;height:8px}.kamoku-cosmo__description{max-width:470px;margin:17px 0 24px;font-size:16px;line-height:1.5}.kamoku-cosmo__desktop-break,.kamoku-cosmo__stamp{display:none}.kamoku-cosmo__email-wrap{min-height:56px}.kamoku-cosmo__email{height:54px;padding-left:17px;font-size:16px}.kamoku-cosmo__submit{width:56px;height:56px;min-width:56px}.kamoku-cosmo__consent{margin-top:15px;font-size:12px;line-height:1.6}}\n@media(prefers-reduced-motion:reduce){.kamoku-cosmo__submit{transition:none}}\n</style>",
        "padding_top": 0,
        "padding_bottom": 0,
        "show_section_divider": false,
        "divider_width": "container"
      }
    }
