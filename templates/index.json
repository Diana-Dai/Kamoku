        "subheading": "<p>Subscribe for store updates and discounts.</p>",
        "description": "<p>By subscribing you agree to the <a href=\"/policies/terms-of-service\" title=\"Terms of Service\">Terms of Use </a>& <a href=\"/policies/privacy-policy\" title=\"Privacy Policy\">Privacy Policy.</a></p>",
        "email_placeholder": "Enter your email",
