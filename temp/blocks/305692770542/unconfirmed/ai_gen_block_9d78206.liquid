                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <div class="ai-partnership-divider-{{ ai_gen_id }}"></div>

        {% if block.settings.column_2_footer != blank %}
          <div class="ai-partnership-footer-{{ ai_gen_id }}">{{ block.settings.column_2_footer }}</div>
        {% endif %}

        {% if block.settings.column_2_image != blank %}
          <div class="ai-partnership-image-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.column_2_image | image_url: width: 600 }}"
              alt="{{ block.settings.column_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_2_image.width }}"
              height="{{ block.settings.column_2_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-partnership-image-{{ ai_gen_id }}">
            <div class="ai-partnership-image-placeholder-{{ ai_gen_id }}"></div>
          </div>
        {% endif %}
      </div>

      <div class="ai-partnership-column-{{ ai_gen_id }}">
        <div 
          class="ai-partnership-accent-{{ ai_gen_id }}" 
          style="background-color: {{ block.settings.column_3_accent }};"
        ></div>

        {% if block.settings.column_3_kicker != blank %}
          <div 
            class="ai-partnership-column-kicker-{{ ai_gen_id }}"
            style="color: {{ block.settings.column_3_accent }};"
          >
            {{ block.settings.column_3_kicker }}
          </div>
        {% endif %}

        {% if block.settings.column_3_title != blank %}
          <h3 class="ai-partnership-column-title-{{ ai_gen_id }}">{{ block.settings.column_3_title }}</h3>
        {% endif %}

        {% if block.settings.column_3_features != blank %}
          <ul class="ai-partnership-features-{{ ai_gen_id }}">
            {% assign features = block.settings.column_3_features | newline_to_br | split: '<br />' %}
            {% for feature in features %}
              {% assign trimmed_feature = feature | strip %}
              {% if trimmed_feature != blank %}
                <li class="ai-partnership-feature-{{ ai_gen_id }}">
                  <span 
                    class="ai-partnership-dash-{{ ai_gen_id }}"
                    style="color: {{ block.settings.column_3_accent }};"
                  >—</span>
                  <span>{{ trimmed_feature }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <div class="ai-partnership-divider-{{ ai_gen_id }}"></div>

        {% if block.settings.column_3_footer != blank %}
          <div class="ai-partnership-footer-{{ ai_gen_id }}">{{ block.settings.column_3_footer }}</div>
        {% endif %}

        {% if block.settings.column_3_image != blank %}
          <div class="ai-partnership-image-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.column_3_image | image_url: width: 600 }}"
              alt="{{ block.settings.column_3_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.column_3_image.width }}"
              height="{{ block.settings.column_3_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-partnership-image-{{ ai_gen_id }}">
            <div class="ai-partnership-image-placeholder-{{ ai_gen_id }}"></div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</partnership-tiers-{{ ai_gen_id }}>

<script>
  (function() {
    class PartnershipTiers{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustColumnHeights();
        window.addEventListener('resize', () => this.adjustColumnHeights());
      }

      adjustColumnHeights() {
        if (window.innerWidth > 989) {
          const columns = this.querySelectorAll('.ai-partnership-column-{{ ai_gen_id }}');
          columns.forEach(column => {
            column.style.minHeight = 'auto';
          });
        }
      }
    }

    customElements.define('partnership-tiers-{{ ai_gen_id }}', PartnershipTiers{{ ai_gen_id }});
  })();
</script>

