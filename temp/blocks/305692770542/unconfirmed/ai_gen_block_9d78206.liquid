          </div>
        {% endif %}

        {% if block.settings.column_2_title != blank %}
          <h3 class="ai-partnership-column-title-{{ ai_gen_id }}">{{ block.settings.column_2_title }}</h3>
        {% endif %}

        {% if block.settings.column_2_features != blank %}
          <ul class="ai-partnership-features-{{ ai_gen_id }}">
            {% assign features = block.settings.column_2_features | newline_to_br | split: '<br />' %}
            {% for feature in features %}
              {% assign trimmed_feature = feature | strip %}
              {% if trimmed_feature != blank %}
                <li class="ai-partnership-feature-{{ ai_gen_id }}">
